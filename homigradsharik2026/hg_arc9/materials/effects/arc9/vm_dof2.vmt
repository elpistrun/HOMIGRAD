screenspace_general
{
	$pixshader "arc9_vm_dof_v2_17_ps30"
	$vertexshader 	"arc9_pp_vs30"

	$basetexture "_rt_FullFrameFB"
	$texture1    "_rt_ResolvedFullFrameDepth"
	$texture2    "arc9_prevm"

	$vertexcolor 1
	$vertextransform 1
	$ignorez        1
	$fix_fb         32768
	"<dx90"
	{
		$no_draw 1
	}
	
	$copyalpha                 1
	$alpha_blend_color_overlay 0
	$alpha_blend               0
	$linearwrite               0
	$linearread_basetexture    0
	$linearread_texture1       0
	$linearread_texture2       0
	$linearread_texture3       0

	$c0_x     0.00390625
	$c0_y     0.0069444444444444


	$c1_x     1
	$c1_y     0.07

	$c2_x     1 // intensity
	$c2_y     0.9 // depth threshold
	$c2_z     1.25 // falloff
	$c2_w     14 // amount of bleed
}
